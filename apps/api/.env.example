# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API (the web app's address).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Leave empty to run with in-memory data (no database needed). Required in production.
MONGODB_URI=

# true/false. Default: true in development and test, false in production (forbidden in production).
# Sample rows are made-up preview data and are always flagged sample:true in the API.
MANDI_SEED_SAMPLE=

RATE_LIMIT_PER_MIN=120

# ---- Admin dashboard (leave JWT_SECRET empty to keep it off) ----
# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Sign-in lifetime in hours.
ADMIN_SESSION_HOURS=12
# Development only, and only without MONGODB_URI: an in-memory admin so you can try the dashboard. Password: 12+ characters.
ADMIN_DEV_EMAIL=
ADMIN_DEV_PASSWORD=
# Folder with the built dashboard. Default: apps/admin/dist (build it with: pnpm --filter @agrixore/admin build)
ADMIN_STATIC_DIR=
# Default: true in production. Set false only to try production mode over plain http.
COOKIE_SECURE=
